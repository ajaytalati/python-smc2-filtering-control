\newlabel{tab:gpu_efficiency}{{5}{6}{Per-horizon GPU utilisation, peak VRAM, and mean power. Mean utilisation rises monotonically with horizon length; peak VRAM stays near 6\,GiB across horizons (well under the 32\,GiB RTX\,5090 capacity)}{table.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces $A$-trajectory summary. The MPC's mean-$A$ improvement over baseline turns positive at $T = 70$ days and grows further at $T = 84$. Final $A$ under MPC reaches $1.24$ at $T = 84$ days vs $0.91$ baseline.}}{6}{table.caption.7}\protected@file@percent }
\newlabel{tab:A_summary}{{6}{6}{$A$-trajectory summary. The MPC's mean-$A$ improvement over baseline turns positive at $T = 70$ days and grows further at $T = 84$. Final $A$ under MPC reaches $1.24$ at $T = 84$ days vs $0.91$ baseline}{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces End-of-trajectory $B$ and $F$, and $F_{\max } = 0.40$ barrier violations. \textbf  {Zero bins violate the barrier across all six horizons}; the controller respects the soft-fatigue constraint without barrier hits.}}{6}{table.caption.8}\protected@file@percent }
\newlabel{tab:BF_summary}{{7}{6}{End-of-trajectory $B$ and $F$, and $F_{\max } = 0.40$ barrier violations. \textbf {Zero bins violate the barrier across all six horizons}; the controller respects the soft-fatigue constraint without barrier hits}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Applied $\Phi $ schedule statistics. ``Stride 21'' is the Julia tech guide's headline metric; this study reproduces it ($0.695$ at $T=28$, matching the technical guide \cite  {techguide}). Mean applied $\Phi $ rises monotonically with horizon (0.25 at $T=14$ to 1.79 at $T=84$), tracking the controller's gradual commitment to higher training under longer planning horizons.}}{7}{table.caption.9}\protected@file@percent }
\newlabel{tab:phi_summary}{{8}{7}{Applied $\Phi $ schedule statistics. ``Stride 21'' is the Julia tech guide's headline metric; this study reproduces it ($0.695$ at $T=28$, matching the technical guide \cite {techguide}). Mean applied $\Phi $ rises monotonically with horizon (0.25 at $T=14$ to 1.79 at $T=84$), tracking the controller's gradual commitment to higher training under longer planning horizons}{table.caption.9}{}}
