\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The v2 healthy island. Blue: $\bar  \mu (0; \Phi ) > 0$. Red: $\bar  \mu (0; \Phi ) < 0$. Black solid contour: $\bar  \mu = 0$ under v2 (the closed-island boundary). Dashed gray: canonical baseline island contour, for scale comparison (tiny, centred at $(0.30, 0.30)$). Green dot: target $(1, 1)$. Purple: sedentary policy probe. Red dot: over-training probe.}}{8}{figure.1}\protected@file@percent }
\newlabel{fig:island-v2}{{1}{8}{The v2 healthy island. Blue: $\bar \mu (0; \Phi ) > 0$. Red: $\bar \mu (0; \Phi ) < 0$. Black solid contour: $\bar \mu = 0$ under v2 (the closed-island boundary). Dashed gray: canonical baseline island contour, for scale comparison (tiny, centred at $(0.30, 0.30)$). Green dot: target $(1, 1)$. Purple: sedentary policy probe. Red dot: over-training probe}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Theorem~6.2 (Constructive escape from \texttt  {SEDENTARY\_INIT})}{8}{subsection.6.2}\protected@file@percent }
\newlabel{thm:t62}{{5}{8}{Constructive escape from sedentary basin}{theorem.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The sedentary basin under v2. \textbf  {Left column} (Theorem~\ref {thm:t61}): passive policy $\Phi \equiv (0.1, 0.1)$ collapses $A$ to zero by day $\sim 50$. \textbf  {Right column} (Theorem~\ref {thm:t62}): the FIM-selected witness $\Phi ^* \equiv (0.86, 1.24)$ drives $A$ from $0.10$ to $1.16$ over 100 days. The middle row shows the chronic capacities $B$ (blue) and $S$ (orange) and fatigue $F$ (red) trajectories; under the witness, $B$ crosses $B_{\rm  dec} = 0.25$ in $\sim 6$\,d.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:sedentary-witness}{{2}{9}{The sedentary basin under v2. \textbf {Left column} (Theorem~\ref {thm:t61}): passive policy $\Phi \equiv (0.1, 0.1)$ collapses $A$ to zero by day $\sim 50$. \textbf {Right column} (Theorem~\ref {thm:t62}): the FIM-selected witness $\Phi ^* \equiv (0.86, 1.24)$ drives $A$ from $0.10$ to $1.16$ over 100 days. The middle row shows the chronic capacities $B$ (blue) and $S$ (orange) and fatigue $F$ (red) trajectories; under the witness, $B$ crosses $B_{\rm dec} = 0.25$ in $\sim 6$\,d}{figure.2}{}}
